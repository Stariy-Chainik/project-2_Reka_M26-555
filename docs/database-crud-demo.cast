{"version": 2, "width": 108, "height": 28, "timestamp": 1793953090, "idle_time_limit": 1.5, "env": {"TERM": "xterm-256color"}, "title": "Примитивная база данных — CRUD-операции"}
[0.203196, "o", "$ uv tool install --quiet dist/primitive_db-0.4.0-py3-none-any.whl\r\n"]
[1.42456, "o", "$ uv tool list\r\n"]
[1.464712, "o", "primitive-db v0.4.0\r\n- database\r\n- project\r\n"]
[2.27277, "o", "\r\n$ database\r\n"]
[2.569722, "o", "***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> <столбец2:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\n***Операции с данными***\r\n<command> insert into <таблица> values (<значение1>, <значение2>, ...)\r\n<command> select from <таблица> [where <столбец> = <значение>]\r\n<command> update <таблица> set <столбец> = <значение> where <столбец> = <значение>\r\n<command> delete from <таблица> where <столбец> = <значение>\r\n<command> info <таблица> - показать схему и количество записей\r\n\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\nВведите к"]
[2.569817, "o", "оманду: "]
[3.675729, "o", "create_table users name:str age:int is_active:bool\r\n"]
[3.676842, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\nВведите команду: "]
[4.779658, "o", "insert into users values (\"Sergei\", 28, true)\r\n"]
[4.782173, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\nВведите команду: "]
[5.887368, "o", "select from users\r\n"]
[6.09568, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\nВведите команду: "]
[7.198283, "o", "select from users where age = 28\r\n"]
[7.199218, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\nВведите команду: "]
[8.304519, "o", "update users set age = 29 where name = \"Sergei\"\r\n"]
[8.308408, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\nВведите команду: "]
[9.412969, "o", "select from users where age = 29\r\n"]
[9.413957, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+\r\nВведите команду: "]
[10.516336, "o", "delete from users where ID = 1\r\n"]
[10.518442, "o", "Запись с ID=1 успешно удалена из таблицы \"users\".\r\nВведите команду: "]
[11.619946, "o", "info users\r\n"]
[11.620965, "o", "Таблица: users\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\nКоличество записей: 0\r\nВведите команду: "]
[12.726147, "o", "exit\r\n"]
