[9.927136, "o", "select from users where age = 29\r\n"]
[9.927492, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[9.927701, "o", "+----+------+-----+-----------+\r\n| ID | name | age | is_active |\r\n+----+------+-----+-----------+\r\n| 1  | Анна |  29 |    True   |\r\n+----+------+-----+-----------+\r\n"]
[9.927712, "o", "Введите команду: "]
